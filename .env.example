# Copia este archivo como .env.local y completa los valores reales.
# .env.local NO se sube al repositorio (está en .gitignore).
# La maqueta actual no usa ninguna de estas variables: funciona con /data/catalog.ts.

# Plataforma de tienda que reemplazará al catálogo local: "local" | "shopify" | "woocommerce"
NEXT_PUBLIC_STORE_PROVIDER=local

# URL pública del sitio (para metadatos y SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Shopify (Storefront API) ---
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# --- WooCommerce (REST API) ---
WOOCOMMERCE_URL=https://tu-dominio.pe
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
